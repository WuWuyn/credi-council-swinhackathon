# CreditLens Environment Configuration
# Copy this to .env and fill in your actual API key

# Google Gemini API Key (required for LLM features)
GEMINI_API_KEY=your_gemini_api_key_here

# Application
APP_ENV=development
LOG_LEVEL=INFO
MODEL_PATH=models/lgbm_ref_v1.pkl

# Ingestion mode: true → OCR parse PDFs | false → read application_row.json directly
USE_OCR=true
# Docling+LLM extraction: true → Docling+EasyOCR+Gemini | false → PyMuPDF+regex
USE_DOCLING=true
# Device for AI models (Docling layout, TableFormer, EasyOCR): cpu | cuda | mps (Apple)
DOCLING_DEVICE=cpu

# Gemini Model Configuration
GEMINI_MODEL=gemini-3.1-flash-lite-preview
GEMINI_RAG_MODEL=gemini-3.1-flash-lite-preview

FILE_SEARCH_STORE_NAME=your_gemini_api_key_here