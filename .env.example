# ── AWS Credentials ──
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Amazon Bedrock (Claude) ──
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_MAX_TOKENS=4096

# ── Amazon Textract ──
TEXTRACT_BUCKET=creditlens-documents

# ── SageMaker Endpoint ──
SAGEMAKER_ENDPOINT_NAME=creditlens-lgbm-endpoint

# ── DynamoDB ──
DYNAMODB_TABLE_STATE=creditlens-state
DYNAMODB_TABLE_AUDIT=creditlens-audit

# ── OpenSearch Serverless (RAG) ──
OPENSEARCH_ENDPOINT=
OPENSEARCH_INDEX=policy-docs

# ── S3 ──
S3_BUCKET_DOCUMENTS=creditlens-documents
S3_BUCKET_MODELS=creditlens-models

# ── Application ──
APP_ENV=development
LOG_LEVEL=INFO
MODEL_PATH=models/lgbm_v1.pkl
DATA_DIR=home-credit-default-risk
