# CreditLens Environment Configuration
# Copy this to .env and fill in your actual API key

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Toggle mock mode (true = no real API calls, false = real Gemini API)
USE_MOCK=false

# Model path
MODEL_PATH=models/lgbm_ref_v1.pkl

# FE stats path
FE_STATS_PATH=models/fe_stats.pkl
