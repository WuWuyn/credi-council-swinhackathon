# ╔══════════════════════════════════════════════════════════════════╗
# ║           CreditLens AI — Environment Configuration             ║
# ║  Copy file này thành .env và điền thông tin AWS của bạn         ║
# ║  Để chạy offline (mock mode): đặt APP_ENV=development           ║
# ╚══════════════════════════════════════════════════════════════════╝

# ── AWS Credentials ───────────────────────────────────────────────
# Dùng chung cho mọi boto3 client (Textract, Bedrock, SageMaker...)
AWS_REGION=ap-southeast-1            # Region triển khai; ap-southeast-1 = Singapore
AWS_ACCESS_KEY_ID=                   # IAM access key (để trống nếu dùng IAM Role)
AWS_SECRET_ACCESS_KEY=               # IAM secret key (để trống nếu dùng IAM Role)

# ── Amazon Bedrock / Claude (Agent A2 & A4) ───────────────────────
# A2: trích xuất semantic features từ văn bản loan application
# A4: sinh báo cáo 4C tiếng Việt được grounded bởi SHAP values
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0  # Model đang dùng
BEDROCK_MAX_TOKENS=4096              # Giới hạn token mỗi lần gọi LLM

# ── Amazon Textract (Agent A1 — Channel 1) ────────────────────────
# OCR tài liệu PDF/scan: CCCD, Hợp đồng lao động, GPKD, TSBĐ
TEXTRACT_BUCKET=creditlens-documents # S3 bucket tạm chứa file trước khi gửi Textract

# ── SageMaker Endpoint (Agent A3 — production) ────────────────────
# LightGBM model được host trên SageMaker RT Endpoint
# Để trống → tự động fallback sang local model file (MODEL_PATH bên dưới)
SAGEMAKER_ENDPOINT_NAME=creditlens-lgbm-endpoint

# ── DynamoDB (Audit Trail) ────────────────────────────────────────
# Lưu trữ CreditState và audit trail bất biến (append-only)
DYNAMODB_TABLE_STATE=creditlens-state  # 1 row per application_id
DYNAMODB_TABLE_AUDIT=creditlens-audit  # Immutable log mọi agent action

# ── OpenSearch Serverless (Agent A4 — RAG) ────────────────────────
# Vector store cho policy documents (Thông tư NHNN, quy định CIC)
# A4 query top-3 clauses → inject vào prompt → cite trong báo cáo
OPENSEARCH_ENDPOINT=                 # URL collection, vd: https://xxx.ap-southeast-1.aoss.amazonaws.com
OPENSEARCH_INDEX=policy-docs         # Index name chứa embedded policy docs

# ── S3 Storage ────────────────────────────────────────────────────
S3_BUCKET_DOCUMENTS=creditlens-documents  # Upload PDF trước Textract + lưu raw docs
S3_BUCKET_MODELS=creditlens-models        # Model artifacts (.pkl) + SHAP JSON outputs

# ── Application ───────────────────────────────────────────────────
APP_ENV=development      # "development" → mock AWS services | "production" → real AWS
LOG_LEVEL=INFO           # DEBUG / INFO / WARNING / ERROR
MODEL_PATH=models/lgbm_v1.pkl  # Path local model file (dùng khi SAGEMAKER_ENDPOINT_NAME trống)
DATA_DIR=home-credit-default-risk  # Thư mục dataset CSV (dùng khi training)
