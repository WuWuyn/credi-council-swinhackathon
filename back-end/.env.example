# ── CrediCouncil Local Configuration ─────────────────────────────────────────
# Copy file này thành .env:  cp .env.example .env
# Không commit file .env lên git (đã có trong .gitignore)

# ─── API Server ───────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
API_V1_STR=/v1
PROJECT_NAME=CrediCouncil AI API
PROJECT_DESCRIPTION=Credit Scoring & Creditworthiness Assessment for Underbanked & Micro SMEs
VERSION=1.0.0

# CORS: dùng * cho dev, production nên giới hạn origin cụ thể
# Ví dụ production: BACKEND_CORS_ORIGINS=["https://credicouncil.app","https://www.credicouncil.app"]
BACKEND_CORS_ORIGINS=["*"]

# ─── ML Model ─────────────────────────────────────────────────────────────────
# Đường dẫn tương đối từ back-end/ hoặc tuyệt đối
MODEL_PATH=models/lgbm_ref_v1.pkl

# ─── Ingestion Pipeline ───────────────────────────────────────────────────────
# Tuỳ chọn: cpu | cuda | mps (Apple Silicon)
DOCLING_DEVICE=cpu

# ─── Google Gemini ────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite-preview
GEMINI_RAG_MODEL=gemini-3.1-flash-lite-preview
FILE_SEARCH_STORE_NAME=your_file_search_store_name_here